// =====================================================================
// 光之戰士飛地：Firestore 權限規則
// 注意：這個檔案只是版本紀錄，改了之後要到 Firebase 主控台 → Firestore → 規則 貼上並發布才會生效
// 目前這一版包含 Phase 4 建議的 signedIn() 修正；發布前請先在規則模擬器確認
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ 團長：Discord ID（主要）或 Google 帳號（備用），要和 config.js 一致
    function isOwner() {
      return request.auth != null && (
        request.auth.token.get('dc', '') == '886243755051601921'
        || (request.auth.token.get('email', '') == 'lq0408@gmail.com'
            && request.auth.token.get('email_verified', false) == true)
      );
    }

    // 「已登入」＝飛地成員：用 Discord 登入（Worker 發的帳號帶有 dc），或總團長的 Google 帳號
    // （Phase 4 修正：原本只檢查 request.auth != null，任何 Google 帳號都能從「備用登入」進來讀取團員資料）
    function signedIn() {
      return request.auth != null
        && (request.auth.token.get('dc', '') != '' || isOwner());
    }

    // Discord 登入的使用者：帳號 ID 一定是 dc_ 加上 Discord ID（只有 Worker 能發這種帳號）
    function isDiscordUser(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'dc_' + request.auth.token.get('dc', 'x');
    }

    // 舊版調查（沒有自己名單的）使用的固定名單
    function isLegacyMember(m) {
      return m in ['satoru','paku','shanzhuang','fengzhi','sansan','lailaizi','jman','caobadao'];
    }

    // 回覆者必須是這份調查名單裡的人
    function isSurveyMember(s, m) {
      return (s.get('memberKeys', []).size() > 0 && m in s.memberKeys)
          || (s.get('memberKeys', []).size() == 0 && isLegacyMember(m));
    }

    // 常用團隊：只有團長能讀寫
    match /teams/{tid} {
      allow read, write: if isOwner();
    }

    // 出席調查的團長：該固定團 leaders 裡有 survey 權限的人
    function surveyLeader(tid) {
      return request.auth != null && tid is string && tid != ''
        && get(/databases/$(database)/documents/statics/$(tid)).data.get('leaders', {}).get(request.auth.uid, {}).get('survey', false) == true;
    }

    // 調查：所有人可讀；總團長可管理全部，團長只能管理自己那團（tid）的調查
    match /surveys/{sid} {
      allow read: if true;
      allow create: if isOwner() || surveyLeader(request.resource.data.get('tid', ''));
      allow update: if isOwner() || (
        surveyLeader(resource.data.get('tid', ''))
        && request.resource.data.get('tid', '') == resource.data.get('tid', '')
      );
      allow delete: if isOwner() || surveyLeader(resource.data.get('tid', ''));

      // 回覆：拿到網址的人都能填，但必須是該調查名單裡的隊員，且調查還沒截止
      match /responses/{member} {
        allow read: if true;
        allow delete: if isOwner() || surveyLeader(get(/databases/$(database)/documents/surveys/$(sid)).data.get('tid', ''));
        allow create, update: if exists(/databases/$(database)/documents/surveys/$(sid))
          && isSurveyMember(get(/databases/$(database)/documents/surveys/$(sid)).data, member)
          && get(/databases/$(database)/documents/surveys/$(sid)).data.closed == false
          && request.resource.data.keys().hasOnly(['slots', 'updatedAt', 'note'])
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 100))
          && request.resource.data.slots is map
          && request.resource.data.slots.size() <= 21
          && request.resource.data.updatedAt is number;
      }
    }

    // ===== 固定團基地 =====

    // 靈魂水晶：登入的人都能看；只能改自己的（總團長可改任何人）
    match /users/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner();
      // 代建：有成員管理權的團長，可以用 Discord ID 替還沒登入的人建立水晶（標記 placeholder）
      allow create: if signedIn()
        && request.resource.data.get('placeholder', false) == true
        && uid == 'dc_' + request.resource.data.dc
        && canLead(request.resource.data.get('placeholderTid', ''), 'members');
      allow update: if signedIn()
        && resource.data.get('placeholder', false) == true
        && request.resource.data.get('placeholder', false) == true
        && request.resource.data.dc == resource.data.dc
        && canLead(resource.data.get('placeholderTid', ''), 'members');
      allow create, update: if isOwner() || (
        isDiscordUser(uid)
        && request.resource.data.dc == request.auth.token.dc
        && request.resource.data.keys().hasOnly(['dc','dcName','avatar','nick','charName','server','job','subJobs','bio','createdAt','updatedAt','placeholder','placeholderTid','createdBy'])
        && request.resource.data.get('nick', '').size() <= 20
        && request.resource.data.get('charName', '').size() <= 30
        && request.resource.data.get('server', '').size() <= 20
        && request.resource.data.get('bio', '').size() <= 60
        && request.resource.data.get('subJobs', []).size() <= 10
      );
    }

    // 固定團
    //  總團長：全部權限，唯一能建立／刪除固定團、指派團長（leaders 欄位）
    //  團長：由總團長在 leaders 裡開放 members（成員管理）、info（團隊資料）、modules（功能開放）
    function leaderCaps(tid) {
      return get(/databases/$(database)/documents/statics/$(tid)).data.get('leaders', {}).get(request.auth.uid, {});
    }
    function canLead(tid, cap) {
      return signedIn() && tid is string && tid != '' && leaderCaps(tid).get(cap, false) == true;
    }
    function leaderMayUpdate() {
      let caps = resource.data.get('leaders', {}).get(request.auth.uid, {});
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['name', 'slogan', 'intro', 'targets', 'size', 'roles', 'modules'])
        && (caps.get('info', false) == true || !keys.hasAny(['name', 'slogan', 'intro', 'targets', 'size']))
        && (caps.get('members', false) == true || !keys.hasAny(['roles']))
        && (caps.get('modules', false) == true || !keys.hasAny(['modules']));
    }

    function myMemberDoc(tid) {
      return get(/databases/$(database)/documents/statics/$(tid)/members/$(request.auth.uid)).data;
    }
    function isActiveMember(tid) {
      return signedIn()
        && exists(/databases/$(database)/documents/statics/$(tid)/members/$(request.auth.uid))
        && myMemberDoc(tid).get('status', '') == 'active';
    }
    function bisPerm(tid) {
      return myMemberDoc(tid).get('perms', {}).get('bis', 'none');
    }
    function bisCanView(tid) {
      let st = get(/databases/$(database)/documents/statics/$(tid)).data;
      let status = st.get('modules', {}).get('bis', 'owner');
      return isOwner()
        || (signedIn() && st.get('leaders', {}).get(request.auth.uid, {}).get('modules', false) == true)
        || (isActiveMember(tid) && (status == 'all' || (status == 'selected' && bisPerm(tid) != 'none')));
    }
    function bisCanEditAll(tid) {
      return isOwner() || (bisCanView(tid) && isActiveMember(tid) && bisPerm(tid) == 'all');
    }
    function bisCanEditOwn(tid, uid) {
      return signedIn() && request.auth.uid == uid && bisCanView(tid) && isActiveMember(tid) && bisPerm(tid) in ['own', 'all'];
    }

    // ===== 減傷軸 =====
    //  看得到：同 BiS（總團長、團長、依功能開放狀態的成員）
    //  編輯全部：總團長、該團團長（leaders），或權限「編輯全部」的成員
    //  編輯自己的：權限「編輯自己的」，只能改陣容裡自己那個位置（roles）的分工
    function mitPerm(tid) {
      return myMemberDoc(tid).get('perms', {}).get('mit', 'none');
    }
    function mitCanView(tid) {
      let st = get(/databases/$(database)/documents/statics/$(tid)).data;
      let status = st.get('modules', {}).get('mit', 'owner');
      return isOwner()
        || (signedIn() && request.auth.uid in st.get('leaders', {}))
        || (isActiveMember(tid) && (status == 'all' || (status == 'selected' && mitPerm(tid) != 'none')));
    }
    function mitCanEditAll(tid) {
      return isOwner()
        || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/statics/$(tid)).data.get('leaders', {}))
        || (mitCanView(tid) && isActiveMember(tid) && mitPerm(tid) == 'all');
    }
    function mitCanEditSlot(tid, slot) {
      return mitCanEditAll(tid) || (
        mitCanView(tid) && isActiveMember(tid) && mitPerm(tid) in ['own', 'all']
        && get(/databases/$(database)/documents/statics/$(tid)).data.get('roles', {}).get(slot, '') == request.auth.uid
      );
    }

    match /statics/{tid} {
      allow read: if signedIn();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (signedIn() && leaderMayUpdate());

      // 成員：自己只能送出「申請中」或取消／退出；核准、權限、移出由總團長或有成員管理權的團長處理
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isOwner() || canLead(tid, 'members') || (
          isDiscordUser(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['status','requestedAt','note'])
          && request.resource.data.get('note', '').size() <= 100
        );
        allow update: if isOwner() || canLead(tid, 'members');
        allow delete: if isOwner() || canLead(tid, 'members') || request.auth.uid == uid;
      }

      // ===== BiS 裝備獲取表 =====
      // 看得到：總團長、有功能開放權的團長，或依功能開放狀態（全團／指定成員）的成員
      // 編輯：總團長；權限「編輯全部」可改任何人與設定、分裝紀錄；「編輯自己的」只能改自己的配裝
      match /bisTiers/{id} {
        allow read: if bisCanView(tid);
        allow write: if bisCanEditAll(tid);
      }
      match /bis/{rid} {
        allow read: if bisCanView(tid);
        allow create: if bisCanEditAll(tid) || bisCanEditOwn(tid, request.resource.data.get('uid', ''));
        allow update: if bisCanEditAll(tid) || (
          bisCanEditOwn(tid, resource.data.get('uid', ''))
          && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        );
        allow delete: if bisCanEditAll(tid);
      }
      match /loot/{id} {
        allow read: if bisCanView(tid);
        allow write: if bisCanEditAll(tid);
      }

      // ===== 減傷軸：本團的爆發、藥水、備註、陣容 =====
      match /mit/{did} {
        allow read: if mitCanView(tid);
        allow write: if mitCanEditAll(tid);

        // 每個位置的減傷分工（MT、H1、D1…各一份）
        match /slots/{slot} {
          allow read: if mitCanView(tid);
          allow create, update: if mitCanEditSlot(tid, slot)
            && request.resource.data.keys().hasOnly(['a', 'o', 'tg', 'updatedAt', 'by'])
            && request.resource.data.a is map;
          allow delete: if mitCanEditAll(tid);
        }
      }

      // 減傷軸的站位圖：壓縮後的圖片，一張一份文件
      match /mitImgs/{id} {
        allow read: if mitCanView(tid);
        allow create: if mitCanEditAll(tid)
          && request.resource.data.keys().hasOnly(['did', 'row', 'data', 'by', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000
          && request.resource.data.by == request.auth.uid;
        allow delete: if mitCanEditAll(tid);
      }
    }

    // ===== 減傷軸：副本機制與技能庫（全站共用，只有總團長能改） =====
    match /mitDuties/{did} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /mitSkills/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // ===== 請假行事曆（全站共用） =====
    //  每個人都能看、能改自己的；總團長能改所有人
    //  awayCfg/main：access 決定誰能看全部（view＝可檢視、lead＝團長，也看得到私人理由）；proxies 決定誰可以幫誰代填
    function awayCfgDoc() {
      return get(/databases/$(database)/documents/awayCfg/main).data;
    }
    function awayHasCfg() {
      return exists(/databases/$(database)/documents/awayCfg/main);
    }
    function awayAcc() {
      return awayHasCfg() ? awayCfgDoc().get('access', {}).get(request.auth.uid, '') : '';
    }
    function awayHelper(uid) {
      return awayHasCfg() && awayCfgDoc().get('proxies', {}).get(uid, {}).get(request.auth.uid, false) == true;
    }
    function awayCanEdit(uid) {
      return isOwner() || (signedIn() && (request.auth.uid == uid || awayHelper(uid)));
    }
    match /awayCfg/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /away/{uid} {
      allow read: if awayCanEdit(uid) || (signedIn() && awayAcc() in ['view', 'lead']);
      allow create, update: if awayCanEdit(uid)
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt', 'by'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 100;
      allow delete: if isOwner();
    }
    // 只給團長看的理由，分開存
    match /awayPriv/{uid} {
      allow read: if awayCanEdit(uid) || (signedIn() && awayAcc() == 'lead');
      allow create, update: if awayCanEdit(uid)
        && request.resource.data.keys().hasOnly(['labels', 'updatedAt', 'by'])
        && request.resource.data.labels is map;
      allow delete: if isOwner();
    }

    // 推薦網站：飛地成員投稿 → 總團長審核
    function validLink() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','url','desc','cat','lang','by','byName','status','pinned','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.url is string && d.url.size() <= 500 && d.url.matches('https://[^ ]{3,}')
        && d.get('desc', '').size() <= 60
        && d.cat in ['資料查詢','配裝','戰鬥與排行','減傷與攻略','生活職業','幻化與收藏','小工具','官方','其他']
        && d.lang in ['繁中','簡中','英文','日文','其他'];
    }
    match /links/{id} {
      allow read: if isOwner() || (signedIn() && (resource.data.status == 'approved' || resource.data.by == request.auth.uid));
      allow create: if isOwner() || (
        signedIn() && validLink()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.pinned == false
      );
      allow update: if isOwner() || (
        signedIn() && validLink()
        && resource.data.by == request.auth.uid
        && resource.data.status in ['pending', 'rejected']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.pinned == false
      );
      allow delete: if isOwner() || (
        signedIn() && resource.data.by == request.auth.uid && resource.data.status != 'approved'
      );
    }

    // 揪團活動：飛地成員（Discord 登入）都能發起、回覆；只有發起人和總團長能改活動
    function enclaveMember() {
      return isOwner() || (request.auth != null && request.auth.token.get('dc', '') != '');
    }
    // 揪團代填權限：總團長一對一開放，proxies.{被代填的人}.{代填的人} == true
    function eventHelper(uid) {
      return request.auth != null && exists(/databases/$(database)/documents/eventsCfg/main)
        && get(/databases/$(database)/documents/eventsCfg/main).data.get('proxies', {}).get(uid, {}).get(request.auth.uid, false) == true;
    }
    // 回覆截止（due，毫秒；0 或沒有＝不設定）：截止後只剩總團長和發起人能寫回覆
    function rsvpOpen(eid) {
      let ev = get(/databases/$(database)/documents/events/$(eid)).data;
      return ev.get('due', 0) == 0 || request.time.toMillis() < ev.get('due', 0)
        || isOwner() || ev.get('by', '') == request.auth.uid;
    }
    match /events/{eid} {
      allow read: if enclaveMember();
      allow create: if enclaveMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.get('desc', '').size() <= 1500
        && request.resource.data.get('due', 0) is number;
      allow update: if isOwner() || (enclaveMember()
        && resource.data.by == request.auth.uid
        && request.resource.data.by == resource.data.by
        && request.resource.data.get('desc', '').size() <= 1500
        && request.resource.data.get('due', 0) is number);
      allow delete: if isOwner() || (enclaveMember() && resource.data.by == request.auth.uid);
      match /rsvp/{uid} {
        allow read: if enclaveMember();
        allow create, update: if enclaveMember() && (request.auth.uid == uid || isOwner() || eventHelper(uid))
          && rsvpOpen(eid)
          && request.resource.data.keys().hasOnly(['go','slots','jobs','note','at','updatedAt','by'])
          && request.resource.data.go in ['y','m','n'];
        allow delete: if isOwner() || eventHelper(uid) || (enclaveMember() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/events/$(eid)).data.by == request.auth.uid));
      }
    }
    match /eventsCfg/{id} {
      allow read: if enclaveMember();
      allow write: if isOwner();
    }

    // ===== 飛地回憶錄（Phase 3 新增）=====
    //  看得到：飛地成員（Discord 登入）與總團長；未登入、非 Discord 帳號都看不到
    //  新增：飛地成員，作者必須是自己
    //  修改、刪除：作者或總團長
    //  被標記的成員：可以把「自己」從參與名單移除（不想被標記時用），其他欄位不能動
    //  照片另外存在 memoryImgs，每張一份文件（同減傷軸站位圖的做法），列表只讀小縮圖
    function memKinds() {
      return ['first', 'prog', 'gather', 'festival', 'daily', 'other'];
    }
    function isImgData(s) {
      return s is string && s.split(',')[0] in ['data:image/webp;base64', 'data:image/jpeg;base64'];
    }
    function validMemory(d) {
      return d.keys().hasOnly(['title','date','kind','desc','tid','eid','duty','members','note','thumb','imgs','by','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.kind in memKinds()
        && d.get('desc', '') is string && d.get('desc', '').size() <= 300
        && d.get('tid', '') is string && d.get('tid', '').size() <= 40
        && d.get('eid', '') is string && d.get('eid', '').size() <= 40
        && d.get('duty', '') is string && d.get('duty', '').size() <= 40
        && d.get('note', '') is string && d.get('note', '').size() <= 200
        && d.get('members', []) is list && d.get('members', []).size() <= 24
        && d.get('imgs', []) is list && d.get('imgs', []).size() <= 4
        && (d.get('thumb', '') == '' || (isImgData(d.thumb) && d.thumb.size() <= 60000))
        && d.by is string && d.createdAt is number && d.updatedAt is number;
    }
    match /memories/{mid} {
      allow read: if enclaveMember();
      allow create: if enclaveMember()
        && request.resource.data.by == request.auth.uid
        && validMemory(request.resource.data);
      allow update: if (
          (isOwner() || (enclaveMember() && resource.data.by == request.auth.uid))
          && request.resource.data.by == resource.data.by
          && validMemory(request.resource.data)
        ) || (
          enclaveMember()
          && request.auth.uid in resource.data.get('members', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        );
      allow delete: if isOwner() || (enclaveMember() && resource.data.by == request.auth.uid);
    }
    match /memoryImgs/{id} {
      allow read: if enclaveMember();
      allow create: if enclaveMember()
        && request.resource.data.keys().hasOnly(['mid', 'data', 'w', 'h', 'by', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.mid is string
        && isImgData(request.resource.data.data)
        && request.resource.data.data.size() <= 950000;
      allow delete: if isOwner() || (enclaveMember() && resource.data.by == request.auth.uid);
      // 不開放修改：要換照片就刪掉再上傳
    }

    // 讓飛地大廳能一次讀取所有固定團的成員
    match /{path=**}/members/{uid} {
      allow read: if signedIn();
    }

    // 讓頁面能一次讀取所有調查的回覆
    match /{path=**}/responses/{member} {
      allow read: if true;
    }
  }
}
